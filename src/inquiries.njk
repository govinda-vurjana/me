---
layout: layouts/base.njk
title: Inquiries
description: Lines of research, each starting from one question, with a timeline of everything that happened along the way.
permalink: /inquiries/
---
{% import "macros.njk" as ui %}
<header class="page-head">
  <h1>Inquiries</h1>
  <p class="dek">An inquiry is a question I have decided to stay with. Each one has a start, sometimes an end, and a timeline of everything that happened in between: thoughts, notes, experiments, and results.</p>
</header>

{%- set chart = collections.inquiries | timelineChart(collections.entries) %}
{%- if chart %}
<section class="section section--wide section--tight">
  <header class="section-head"><h2 class="section-label">Over time</h2></header>
  {{ ui.timeline(chart) }}
</section>
{%- endif %}

{%- set groups = [
  ["Exploring now", collections.inquiries | inStatus("exploring")],
  ["Paused", collections.inquiries | inStatus("paused")],
  ["Up next", collections.inquiries | inStatus("planned")],
  ["Concluded", collections.inquiries | inStatus("concluded")]
] %}
{%- for group in groups %}
{%- if group[1].length %}
<section class="section">
  <header class="section-head"><h2 class="section-label">{{ group[0] }}</h2></header>
  <div class="inquiry-list">
    {%- for inq in group[1] %}
    {{ ui.inquiryCard(inq, collections.entries) }}
    {%- endfor %}
  </div>
</section>
{%- endif %}
{%- endfor %}
