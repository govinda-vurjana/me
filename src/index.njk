---
layout: layouts/base.njk
---
{% import "macros.njk" as ui %}
{%- set exploring = collections.topics | inStatus("exploring") %}

<section class="hero">
  <p class="eyebrow">{{ site.tagline }}</p>
  <h1 class="thesis">How do machines <em>remember</em>, <em>retrieve</em>, and <em>think</em>?</h1>
  <div class="hero-text">
    <p>I'm Govinda Vurjana. I work on memory in artificial intelligence: how a system keeps what it has seen, finds it again when it matters, and how remembering turns into thinking.</p>
  </div>
  {%- if exploring.length %}
  <p class="now-line">
    <span class="status status--exploring">Now</span>
    {%- for t in exploring %}
    <a href="{{ t.url }}">{{ t.data.title }}</a><span class="meta"> since {{ t.data.started | month }}</span>{% if not loop.last %}<span class="sep">·</span>{% endif %}
    {%- endfor %}
  </p>
  {%- endif %}
</section>

<section class="section">
  <ul class="section-index">
    <li><a href="/experiments/">Experiments</a><p>Small experiments with results, and the code behind them.</p></li>
    <li><a href="/memory/">AI Memory</a><p>How machines remember, retrieve, and think, with a timeline for each topic.</p></li>
    <li><a href="/math/">Math</a><p>Derivations, proofs, and worked notes.</p></li>
    <li><a href="/books/">Books</a><p>What I am reading and have read.</p></li>
  </ul>
</section>

{%- if collections.entries.length %}
<section class="section">
  <header class="section-head">
    <h2 class="section-label">Latest</h2>
    <a class="more" href="/notebook/">Everything →</a>
  </header>
  <ol class="entry-list">
    {%- for entry in collections.entries | limit(6) %}
    {{ ui.entryRow(entry, collections.topics, true) }}
    {%- endfor %}
  </ol>
</section>
{%- endif %}
