<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " · " + site.title) if (title and page.url != "/") else (site.title + " · " + site.tagline) %}
  {%- set pageDescription = summary or question or description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta name="author" content="{{ site.author }}">
  <link rel="canonical" href="{{ page.url | absUrl }}">

  <meta property="og:type" content="{{ 'article' if kind else 'website' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:url" content="{{ page.url | absUrl }}">
  <meta property="og:image" content="{{ '/assets/img/portrait.jpg' | absUrl }}">
  <meta name="twitter:card" content="summary">
  {%- if kind %}
  <meta property="article:published_time" content="{{ page.date | iso }}">
  {%- endif %}

  <meta name="theme-color" content="#f6f4ee" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#131210" media="(prefers-color-scheme: dark)">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap">
  <link rel="stylesheet" href="/assets/css/site.css">
  {%- if content | hasMath %}
  <link rel="stylesheet" href="/assets/vendor/katex/katex.min.css">
  {%- endif %}
  <script>try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="wrap">
    <header class="site-header">
      <a class="site-name" href="/">{{ site.title }}</a>
      <nav class="site-nav" aria-label="Main">
        {%- set nav = [["Inquiries", "/inquiries/"], ["Notebook", "/notebook/"], ["Mathematics", "/mathematics/"]] %}
        {%- if collections.papers.length %}{% set nav = nav.concat([["Papers", "/papers/"]]) %}{% endif %}
        {%- set nav = nav.concat([["Projects", "/projects/"], ["About", "/about/"]]) %}
        {%- for item in nav %}
        <a href="{{ item[1] }}"{% if page.url.startsWith(item[1]) %} aria-current="page"{% endif %}>{{ item[0] }}</a>
        {%- endfor %}
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch between light and dark">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"/></svg>
      </button>
    </header>

    <main id="main">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <p>
        <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        {%- for link in site.links %} · <a href="{{ link.url }}" rel="me">{{ link.label }}</a>{% endfor %}
        · <a href="/feed.xml">Feed</a>
      </p>
      <p>Last updated {{ builtAt | day }}.</p>
    </footer>
  </div>
  <script src="/assets/js/site.js" defer></script>
</body>
</html>
