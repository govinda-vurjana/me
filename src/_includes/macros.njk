{#- Shared building blocks. Import with:  {% import "macros.njk" as ui %} -#}

{% macro mark(kind) -%}
<span class="mark mark--{{ kind }}" aria-hidden="true"></span>
{%- endmacro %}

{% macro draftTag(item) -%}
{%- if item.data.draft %}<span class="draft-tag" title="Visible only in local preview">Draft</span>{% endif -%}
{%- endmacro %}

{# One row in a list of notebook entries. #}
{% macro entryRow(entry, topics, fullDate=false, showTopic=true) %}
{%- set topic = topics | findTopic(entry.data.topic) %}
<li class="entry-row" data-kind="{{ entry.data.kind }}">
  <time class="entry-date" datetime="{{ entry.date | iso }}">{{ (entry.date | day) if fullDate else (entry.date | shortDay) }}</time>
  <div class="entry-main">
    <p class="kind-line">{{ mark(entry.data.kind) }}<span>{{ entry.data.kind | kindLabel }}</span>
      {%- if topic and showTopic %}<span class="sep">·</span><a href="{{ topic.url }}">{{ topic.data.title }}</a>{% endif %}{{ draftTag(entry) }}</p>
    <h3 class="entry-title"><a href="{{ entry.url }}">{{ entry.data.title }}</a></h3>
    {%- if entry.data.summary %}
    <p class="entry-summary">{{ entry.data.summary }}</p>
    {%- endif %}
    {%- if entry.data.result %}
    <p class="entry-result"><span class="label">Result</span> {{ entry.data.result }}</p>
    {%- endif %}
  </div>
</li>
{% endmacro %}

{# A research topic: status, period, summary. #}
{% macro topicCard(topic, entries) %}
{%- set count = (entries | forTopic(topic.fileSlug)).length %}
<article class="topic-card">
  <p class="meta-line">
    <span class="status status--{{ topic.data.status }}">{{ topic.data.status | statusLabel }}</span>
    {%- if topic.data.started %}<span class="sep">·</span>{{ topic.data.started | span(topic.data.ended) }}<span class="sep">·</span>{{ topic.data.started | duration(topic.data.ended) }}{% endif %}
    {%- if count %}<span class="sep">·</span>{{ count }} {{ "entry" if count == 1 else "entries" }}{% endif %}{{ draftTag(topic) }}
  </p>
  <h3 class="topic-title"><a href="{{ topic.url }}">{{ topic.data.title }}</a></h3>
  {%- if topic.data.summary %}
  <p class="topic-summary">{{ topic.data.summary }}</p>
  {%- endif %}
</article>
{% endmacro %}

{# Horizontal research timeline: one track per topic, entries as marks. #}
{% macro timeline(chart) %}
{%- if chart %}
<figure class="tl">
  <div class="tl-row tl-row--axis" aria-hidden="true">
    <div class="tl-label"></div>
    <div class="tl-track tl-axis">
      {%- for t in chart.ticks %}
      <span class="tl-tick" style="left: {{ t.left }}%"><span>{{ t.label }}</span></span>
      {%- endfor %}
      <span class="tl-now-label" style="left: {{ chart.now }}%">now</span>
    </div>
  </div>
  {%- for row in chart.rows %}
  {%- set d = row.topic.data %}
  <div class="tl-row">
    <div class="tl-label">
      <a href="{{ row.topic.url }}">{{ d.title }}</a>
      <span class="tl-dates">{{ d.started | span(d.ended) }} · {{ d.started | duration(d.ended) }}</span>
    </div>
    <div class="tl-track">
      {%- for t in chart.ticks %}<span class="tl-grid" style="left: {{ t.left }}%"></span>{% endfor %}
      <span class="tl-now" style="left: {{ chart.now }}%"></span>
      <span class="tl-bar tl-bar--{{ d.status }}{% if row.ongoing %} is-ongoing{% endif %}" style="left: {{ row.left }}%; width: {{ row.width }}%"></span>
      {%- for m in row.marks %}
      <a class="tl-mark" href="{{ m.entry.url }}" style="left: {{ m.left }}%" title="{{ m.entry.date | day }} · {{ m.entry.data.kind | kindLabel }}: {{ m.entry.data.title }}" aria-label="{{ m.entry.data.kind | kindLabel }}: {{ m.entry.data.title }}">{{ mark(m.entry.data.kind) }}</a>
      {%- endfor %}
    </div>
  </div>
  {%- endfor %}
  <figcaption class="legend">
    <span>{{ mark("thought") }}Thought</span>
    <span>{{ mark("note") }}Note</span>
    <span>{{ mark("experiment") }}Experiment</span>
    <span>{{ mark("paper") }}Paper</span>
  </figcaption>
</figure>
{%- endif %}
{% endmacro %}
