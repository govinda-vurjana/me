{
  "name": "research-notebook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Govinda Vurjana's research notebook: questions, inquiries, experiments and papers.",
  "scripts": {
    "dev": "eleventy --serve --quiet",
